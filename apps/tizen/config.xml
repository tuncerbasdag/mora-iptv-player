<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://iptvplayer.local/IptvPlayer" version="1.0.0" viewmodes="maximized">
  <!-- The Tizen package ID must be exactly 10 alphanumeric characters; the application ID is "<package>.<name>". -->
  <tizen:application id="IptvPlayer.IptvPlayer" package="IptvPlayer" required_version="6.0"/>
  <content src="index.html"/>
  <name>Mora IPTV Player</name>
  <!-- App icon: 117x117 PNG (shown on the TV Apps screen). -->
  <icon src="icon.png"/>
  <!-- IPTV servers generally don't send CORS headers; the web app works around this with a local proxy
       (apps/web), but for Tizen widgets this tag disables the CORS restriction
       (fetch/XHR work without the server sending Access-Control-Allow-Origin). -->
  <access origin="*" subdomains="true"/>
  <feature name="http://tizen.org/feature/screen.size.all"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <!-- For webapis.network.getMac() / isConnectedToGateway() (Samsung Network API docs). -->
  <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                  encryption="disable" install-location="auto" hwkey-event="enable"/>
  <tizen:metadata key="http://samsung.com/tv/metadata/use.network" value="true"/>
</widget>
