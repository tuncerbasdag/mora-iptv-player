{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/**/*.ts",
    "apps/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "apps/tizen/Debug",
    "apps/tizen/.tizen-rds",
    "node_modules"
  ]
}
